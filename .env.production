# ==============================================================================
# Production Environment Configuration for drskpoddar.in
# ==============================================================================

# Database Connection (PostgreSQL)
# Used inside docker network by backend: postgres://...
POSTGRES_USER="clinic_admin"
POSTGRES_PASSWORD="clinic_secure_password_2026"
POSTGRES_DB="clinic_booking_db"
DATABASE_URL="postgresql://clinic_admin:clinic_secure_password_2026@postgres:5432/clinic_booking_db?schema=public"

# Application URLs (Production Domain)
PORT=4000
NODE_ENV=production
APP_URL="https://drskpoddar.in"
FRONTEND_URL="https://drskpoddar.in"
NEXT_PUBLIC_API_URL="https://drskpoddar.in/api"

# Security & Authentication Sessions
# Generate secure random strings: openssl rand -hex 32
JWT_SECRET="replace_with_a_secure_random_32_char_hex_secret_key_jwt"
COOKIE_SECRET="replace_with_a_secure_random_32_char_hex_cookie_key"

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API Credentials
# (From Meta Developers Portal: developers.facebook.com)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN="mock_whatsapp_access_token"
WHATSAPP_PHONE_NUMBER_ID="mock_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="mock_business_account_id"
# Secret token you invent yourself and enter both here and in Meta Webhook config:
WHATSAPP_VERIFY_TOKEN="drskpoddar_clinic_webhook_verify_2026"
WHATSAPP_APP_SECRET="mock_meta_app_secret"

# ------------------------------------------------------------------------------
# HDFC Payment Gateway (SmartGateway / Juspay)
# (From HDFC Merchant Dashboard)
# ------------------------------------------------------------------------------
HDFC_MERCHANT_ID="MOCK_HDFC_MERCHANT"
HDFC_API_KEY="mock_hdfc_api_key"
HDFC_SECRET="mock_hdfc_secret"
HDFC_BASE_URL="https://smartgatewayuat.hdfcbank.com"
HDFC_WEBHOOK_SECRET="mock_webhook_secret_key"
HDFC_RETURN_URL="https://drskpoddar.in/payment-status"

# ------------------------------------------------------------------------------
# Feature Flags (Set to "false" once real Meta & HDFC credentials are added)
# ------------------------------------------------------------------------------
USE_MOCK_PAYMENT="true"
USE_MOCK_WHATSAPP="true"

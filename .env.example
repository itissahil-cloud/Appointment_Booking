# ==============================================================================
# Clinic Appointment & FCFS Token Booking System - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://clinic_admin:clinic_secure_password_2026@localhost:5432/clinic_booking_db?schema=public"

# Application Ports & URLs
PORT=4000
NODE_ENV=development
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Admin Authentication & Sessions
JWT_SECRET="clinic_super_secret_jwt_key_at_least_32_characters_long_for_security"
COOKIE_SECRET="clinic_cookie_secret_key_change_in_production"

# Meta WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_cloud_api_system_user_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_VERIFY_TOKEN="clinic_whatsapp_webhook_secret_verify_token"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_sha256_webhook_verification"

# HDFC Payment Gateway Credentials
# Note: Provided per official HDFC integration specification
HDFC_MERCHANT_ID="your_hdfc_merchant_id"
HDFC_API_KEY="your_hdfc_api_key"
HDFC_SECRET="your_hdfc_secret"
HDFC_BASE_URL="https://smartgatewayuat.hdfcbank.com"
HDFC_WEBHOOK_SECRET="your_hdfc_webhook_signature_secret"
HDFC_RETURN_URL="http://localhost:3000/payment-status"

# Feature Flags
USE_MOCK_PAYMENT="true" # Set to false in production when HDFC credentials are provided
USE_MOCK_WHATSAPP="true" # Set to false in production with active Meta Cloud API

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://clinic_admin:clinic_secure_password_2026@localhost:5432/clinic_booking_db?schema=public"

# Application Ports & URLs
PORT=4000
NODE_ENV=production
APP_URL="https://drskpoddar.in"
FRONTEND_URL="https://drskpoddar.in"
NEXT_PUBLIC_API_URL="https://drskpoddar.in/api"

# Admin Authentication & Sessions
JWT_SECRET="clinic_dev_secret_jwt_key_at_least_32_characters_long_2026"
COOKIE_SECRET="clinic_dev_cookie_secret_key_2026"

# Meta WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN="mock_whatsapp_access_token"
WHATSAPP_PHONE_NUMBER_ID="mock_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="mock_business_account_id"
WHATSAPP_VERIFY_TOKEN="drskpoddar_clinic_webhook_verify_2026"
WHATSAPP_APP_SECRET="mock_meta_app_secret"

# HDFC Payment Gateway Credentials
HDFC_MERCHANT_ID="MOCK_HDFC_MERCHANT"
HDFC_API_KEY="mock_hdfc_api_key"
HDFC_SECRET="mock_hdfc_secret"
HDFC_BASE_URL="https://smartgatewayuat.hdfcbank.com"
HDFC_WEBHOOK_SECRET="mock_webhook_secret_key"
HDFC_RETURN_URL="https://drskpoddar.in/payment-status"

# Feature Flags
USE_MOCK_PAYMENT="true"
USE_MOCK_WHATSAPP="true"
